{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/ursprung",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/erzaehlungen",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/untertext",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/laender",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/bibliothek",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lesen",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ursprung.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/erzaehlungen.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/untertext.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/laender.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/bibliothek.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lesen.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-/SuIognKKR+T9p4PAZJk4AJfeEILPwXRKMZSK7yOE/w=' 'sha256-3zfvBaYUaKFqE+8qngjE3OmyDOphUASYZreAAhrijks=' 'sha256-6eTH80R3yje8x0oRszXWAoxJhTaYw+d3+t1hMMreD6k=' 'sha256-DHFVdxh4+uPpWRB/w6Eja4G++WbfuP0cp5vmC+ldtOY=' 'sha256-Im1jo3wZH/9S2ug3VMo9s1wT12WcHZxwXXi0jPCwsMo=' 'sha256-XgWtH3nhOGDXzNWubjcWUZBxHkv1byPtHi3603+XdSg=' 'sha256-XyoZXBX/UQP5L1y+S0SOJgksKLKMhKiw7ufmGl6OUro=' 'sha256-Z/3ysatTl80+bWqIabSr17Rstshix7jHRiWxHXxzwF0=' 'sha256-f3SR4JxIZa/p8e7qZIabppQ8yeXR/zYYPQksPG5cv88=' 'sha256-kDjACyUZZ5JVJpgKjPOYO3abw8MOSoPIcB35jhKhBbc=' 'sha256-yrz8mQPig2kmIhpBVbmz2p9n7KlH0iWy+lCrwSJbnww='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/([^/.]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(schrift|lib|daten|bilder)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/satoshi",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/vita",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/impressum",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/datenschutz",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
